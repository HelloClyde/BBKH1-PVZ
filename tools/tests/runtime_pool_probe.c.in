/* Actual syscalls allocation bodies, host-native provider only. */
#include <assert.h>
#include <errno.h>
#include <inttypes.h>
#include <setjmp.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "small_pool.h"
#include "runtime.h"

static void *host_allocate(size_t n){return malloc(n);}
static void host_release(void *p){free(p);}
typedef void h1_file;
struct _reent {int unused;};
enum {FILE_COUNT=64};
#define ALLOC_MAGIC 0x50565a41u
static h1_file *files[FILE_COUNT],*log_file;
static char *directory_paths[FILE_COUNT];
volatile uint32_t pvz_runtime_diagnostic[16],pvz_runtime_hole_diagnostic[12];
static unsigned capture_calls,cache_calls,close_events,first_shutdown_free;
static unsigned native_calls,native_successes,native_frees,force_fail;
static size_t native_limit=SIZE_MAX,native_budget=SIZE_MAX,native_bytes,native_peak;
static size_t captured_user,captured_raw;
struct Native {void *raw;size_t bytes;};
static struct Native native[2048];
static void *cache_pointer;
static int cache_reenter;
static int _close(int fd);
static int h1_fclose(h1_file *file);
static void h1_free(void *raw);
size_t pvzh1_cache_memory_pressure(size_t requested);

void pvz_runtime_abort(int code){fprintf(stderr,"unexpected runtime abort %d\n",code);abort();}
void pvz_runtime_capture_heap_failure(size_t user,size_t raw){++capture_calls;captured_user=user;captured_raw=raw;}
void *pvz_runtime_native_allocate(size_t requested,size_t size){
    size_t span=(size+63u+3u)&~(size_t)3u;unsigned i;void *p;(void)requested;
    ++native_calls;pvz_runtime_hole_diagnostic[7]=0;
    if(force_fail||size>native_limit||native_bytes>native_budget||span>native_budget-native_bytes)return 0;
    for(i=0;i<2048&&native[i].raw;i++);assert(i<2048);
    p=host_allocate(span);assert(p);native[i].raw=p;native[i].bytes=span;
    native_bytes+=span;if(native_bytes>native_peak)native_peak=native_bytes;
    ++native_successes;pvz_runtime_hole_diagnostic[7]=(uint32_t)span;return p;
}
static void h1_free(void *raw){
    unsigned i;for(i=0;i<2048&&native[i].raw!=raw;i++);assert(i<2048);
    native_bytes-=native[i].bytes;native[i].raw=0;native[i].bytes=0;++native_frees;
    if(close_events&&!first_shutdown_free)first_shutdown_free=close_events;
    host_release(raw);
}

#define malloc pvz_test_malloc
#define free pvz_test_free
#define calloc pvz_test_calloc
#define realloc pvz_test_realloc
#define aligned_alloc pvz_test_aligned_alloc
#define posix_memalign pvz_test_posix_memalign
/* @GLOBALS@ */
/* @FAILURE@ */
/* @ALLOCATOR@ */
/* @SHUTDOWN@ */

void pvzp_audio_close(void){++close_events;}
void pvzp_window_close(void){++close_events;}
static int h1_fclose(h1_file *file){assert(file);++close_events;return 0;}
static int _close(int fd){assert(fd>=3&&fd<FILE_COUNT+3);++close_events;files[fd-3]=0;directory_paths[fd-3]=0;return 0;}
size_t pvzh1_cache_memory_pressure(size_t requested){
    ++cache_calls;assert(pressure_running&&!small_pool.busy);(void)requested;
    if(!cache_pointer)return 0;
    if(cache_reenter){
        uint32_t callbacks=pvz_runtime_pressure_diagnostic[0];
        force_fail=1;assert(!malloc(9999));force_fail=0;
        assert(pressure_running&&pvz_runtime_pressure_diagnostic[0]==callbacks);
    }
    free(cache_pointer);cache_pointer=0;return 32;
}
static void consistent(void){
    size_t sum=0;for(unsigned i=0;i<2048;i++)if(native[i].raw)sum+=native[i].bytes;
    assert(sum==native_bytes&&sum==pvz_runtime_native_charge[0]);
    assert(small_pool.stats.reserved_bytes<=sum);
    assert(pvz_runtime_small_pool_diagnostic[6]==small_pool.stats.reserved_bytes);
    assert(pvz_runtime_small_pool_diagnostic[3]==small_pool.stats.live_allocations);
}
static void empty(void){
    assert(!allocations&&!pvz_runtime_diagnostic[3]);
    (void)trim_small_pool();consistent();assert(!native_bytes&&!small_pool.stats.pages);
}
int main(void){
    const size_t sizes[]={1,7,8,31,32,95,96,97,120,121,127,128,129,255,256,511,512,997,998,999,1000,1024,2048,3072,4033,4064,4065,4096};
    void *p,*q;size_t retained;unsigned before;
    p=malloc(0);assert(p&&!((uintptr_t)p&7u));consistent();free(p);
    retained=pvz_runtime_native_charge[0];assert(retained&&small_pool.stats.pages==1&&!pvz_runtime_diagnostic[3]);empty();
    for(size_t align=8;align<=32;align*=2){
        for(unsigned i=0;i<sizeof(sizes)/sizeof(sizes[0]);i++){
            assert(!posix_memalign(&p,align,sizes[i]));assert(!((uintptr_t)p&(align-1u)));
            memset(p,0xa5,sizes[i]);consistent();
            for(size_t k=0;k<sizes[i];k++)assert(((unsigned char *)p)[k]==0xa5);
            free(p);consistent();
        }
    }empty();
    assert(!aligned_alloc(16,17)&&errno==EINVAL);assert(posix_memalign(&p,3,12)==EINVAL);
    p=aligned_alloc(32,96);assert(p&&!((uintptr_t)p&31u));free(p);empty();
    p=calloc(19,13);assert(p);for(unsigned i=0;i<247;i++)assert(!((unsigned char *)p)[i]);free(p);
    before=native_calls;assert(!calloc(SIZE_MAX,2)&&errno==ENOMEM&&native_calls==before);empty();
    p=malloc(100);memset(p,0x6b,100);q=realloc(p,3000);assert(q);
    for(unsigned i=0;i<100;i++)assert(((unsigned char *)q)[i]==0x6b);
    p=realloc(q,4096);assert(p);for(unsigned i=0;i<100;i++)assert(((unsigned char *)p)[i]==0x6b);
    q=realloc(p,64);assert(q);for(unsigned i=0;i<64;i++)assert(((unsigned char *)q)[i]==0x6b);
    assert(!realloc(q,0));p=realloc(0,99);free(p);empty();

    /* Large real live set, interleaved frees, original pointers/data retained. */
    static void *live[30000];before=native_successes;
    for(unsigned i=0;i<30000;i++){
        live[i]=malloc(32);assert(live[i]);memset(live[i],(int)(i&255u),32);
        if(!(i%500))consistent();
    }
    unsigned live_set_acquires=native_successes-before;assert(live_set_acquires<300);
    for(unsigned i=0;i<30000;i+=2)free(live[i]);
    for(unsigned i=1;i<30000;i+=2){
        for(unsigned k=0;k<32;k++)assert(((unsigned char *)live[i])[k]==(i&255u));
        free(live[i]);
    }consistent();empty();

    /* Refill failure falls back to the original smaller native request. */
    native_limit=1024;p=malloc(32);assert(p);assert(!(((Allocation *)p-1)->f.raw_span&1u));
    consistent();free(p);native_limit=SIZE_MAX;empty();
    force_fail=1;before=capture_calls;assert(!malloc(32)&&errno==ENOMEM);
    assert(capture_calls==before+1&&captured_user==32&&captured_raw==32+sizeof(Allocation)+7);
    assert(!pressure_running&&!native_bytes&&!allocations);force_fail=0;
    pvz_runtime_diagnostic[12]=pvz_runtime_diagnostic[13]=pvz_runtime_diagnostic[14]=0;

    /* Empty pages are physical capacity: free large block only after trim. */
    p=malloc(32);free(p);assert(native_bytes);
    before=pvz_runtime_pressure_diagnostic[2];native_budget=66000;
    p=malloc(65536);assert(p&&pvz_runtime_pressure_diagnostic[2]==before+1);
    assert(!small_pool.stats.pages);consistent();free(p);native_budget=SIZE_MAX;empty();

    /* A cache eviction makes a retained empty page; trim it before retry.
       Accidental nested failure cannot replace the outer owner/span. */
    cache_pointer=malloc(32);cache_reenter=1;native_budget=66000;before=cache_calls;
    p=malloc(65536);assert(p&&cache_calls==before+1&&!cache_pointer&&!pressure_running);
    assert(!small_pool.stats.pages&&!(((Allocation *)p-1)->f.raw_span&1u));
    consistent();free(p);native_budget=SIZE_MAX;cache_reenter=0;empty();

    /* The actual shutdown body closes DMA/window/handles first, frees every
       tracked allocation, then returns the last retained empty pool pages. */
    for(unsigned i=0;i<80;i++)assert(malloc((i%9)*39+1));
    assert(aligned_alloc(32,320)&&malloc(70000));consistent();
    files[0]=(h1_file *)1;directory_paths[1]=(char *)1;log_file=(h1_file *)2;
    pvz_runtime_shutdown();consistent();
    assert(close_events==5&&first_shutdown_free==5&&!native_bytes&&!allocations);
    assert(!small_pool.stats.pages&&!small_pool.stats.live_allocations&&!small_pool_ready);
    assert(!pvz_runtime_diagnostic[3]&&!pvz_runtime_native_charge[0]);
    printf("PASS actual runtime pool bridge; host_header=%zu native_acquires_for_30000_payload32=%u native_calls=%u frees=%u peak=%zu; alignment/calloc/realloc/nativefallback/pressure/reentry/shutdown all balanced\n",sizeof(Allocation),live_set_acquires,native_calls,native_frees,native_peak);
    return 0;
}
