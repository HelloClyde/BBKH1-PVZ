static h1_file *h1_fopen(const char *p,const char *mode){
 if(!strcmp(mode,"ab")){++logopens;strcpy(logged,p);return log_sentinel?(void*)(uintptr_t)0xffffffffu:(void*)(uintptr_t)0x1234;}
 assert(!strcmp(mode,"rb"));if(strstr(p,"\\H1DATA.MAP")){++marker_opens;marker_pos=0;return marker_mode?(void*)(uintptr_t)0x5678:0;}
