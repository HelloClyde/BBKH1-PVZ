static void reset(int a,int b){available_a=a;available_b=b;fail_a_sentinel=log_sentinel=probes=closes=writes=logopens=marker_mode=marker_opens=marker_closes=0;log_file=0;resource_prefix=native_data_a;resource_drive_detected=asset_bucket_state=0;strcpy(virtual_cwd,"/PVZ");memset((void*)pvz_runtime_diagnostic,0,sizeof(pvz_runtime_diagnostic));memset((void*)pvz_runtime_asset_layout_diagnostic,0,sizeof(pvz_runtime_asset_layout_diagnostic));}
