static unsigned h1_fread(void *p,unsigned size,unsigned count,h1_file*f){assert(size==1&&f==files[0]);tick+=5;++read_calls;read_pointer=p;requested=count;if(read_result==0xffffffffu)return read_result;unsigned n=read_result<count?read_result:count;read_result-=n;return n;}
