 read_result=3;assert(_read(3,buffer,20)==3);read_result=0;assert(_read(3,buffer,20)==0&&!pvz_runtime_io_diagnostic[15]);uint32_t returned=pvz_runtime_io_diagnostic[5];read_result=0xffffffffu;assert(_read(3,buffer,20)==-1&&errno==EIO&&pvz_runtime_io_diagnostic[15]==1&&pvz_runtime_io_diagnostic[5]==returned);unsigned calls=read_calls;assert(_read(0,buffer,20)==0&&read_calls==calls);assert(_read(-1,buffer,20)==-1&&errno==EBADF&&read_calls==calls);
 pvz_runtime_io_diagnostic[4]=0xfffffff0u;read_result=32;tick=0xfffffffeu;uint32_t elapsed=pvz_runtime_io_diagnostic[6];assert(_read(3,buffer,32)==32&&pvz_runtime_io_diagnostic[4]==16&&pvz_runtime_io_diagnostic[6]-elapsed==5);
 assert(_lseek(3,37,SEEK_SET)==37&&seek_offset==37&&seek_origin==SEEK_SET&&pvz_runtime_io_diagnostic[8]==1&&pvz_runtime_io_diagnostic[9]==7);seek_fail=1;assert(_lseek(3,19,SEEK_SET)==-1&&errno==EIO&&pvz_runtime_io_diagnostic[10]==1);seek_fail=0;struct stat st;int before=seek_calls;uint32_t seeks=pvz_runtime_io_diagnostic[8];assert(!_fstat(3,&st)&&st.st_size==100&&st.st_blksize==4096&&seek_offset==13&&seek_calls==before+2&&pvz_runtime_io_diagnostic[8]==seeks+2);before=seek_calls;assert(!_fstat(1,&st)&&st.st_mode==(S_IFCHR|0666)&&seek_calls==before);directory_paths[0]="dir";assert(_fstat(3,&st)==7&&seek_calls==before);
